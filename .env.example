# No credentials needed for the local fixture demo.
KAIROS_STORAGE=sqlite
KAIROS_SQLITE_PATH=backend/data/kairos.sqlite3
KAIROS_FRONTEND_ORIGIN=http://localhost:3000
# Switch to falkordb after starting a local container or supplying a cloud endpoint.
KAIROS_FALKORDB_URL=redis://localhost:6379
KAIROS_GRAPH_NAME=kairos
# Optional shared demo key. This is not multi-user authentication.
KAIROS_API_KEY=
# External integrations (next slices). Set real values only in .env.
KAIROS_BRIGHTDATA_API_KEY=
KAIROS_BRIGHTDATA_ZONE=
KAIROS_OPENAI_API_KEY=
# Optional; empty means gpt-6-astra.
KAIROS_OPENAI_MODEL=
# Optional; empty means gpt-transcribe (speech-to-text for voice notes).
KAIROS_OPENAI_TRANSCRIBE_MODEL=
# Authentication: "clerk" (default; each signed-in user gets their own graph) or "none" (local dev only).
KAIROS_AUTH_MODE=clerk
KAIROS_CLERK_PUBLISHABLE_KEY=
# Used only to look up verified emails for admins. Never exposed to the browser.
KAIROS_CLERK_SECRET_KEY=
# Comma-separated emails with no usage limits.
KAIROS_ADMIN_EMAILS=
# Daily limits for regular users (defaults shown).
KAIROS_LIMIT_EVENT_FETCHES_PER_DAY=3
KAIROS_LIMIT_DRAFTS_PER_DAY=20
KAIROS_LIMIT_VOICE_NOTES_PER_DAY=30
KAIROS_LIMIT_REQUESTS_PER_MINUTE=120
KAIROS_LIMIT_GLOBAL_EVENT_FETCHES_PER_DAY=30
